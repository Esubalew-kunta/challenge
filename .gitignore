# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
# Les journaux du serveur de développement, redirigés à la main quand on le
# lance en arrière-plan. Ils portent des adresses locales et des traces, ils
# n'ont rien à faire dans l'historique.
dev-*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.next.nosync/
.gstack/
aimakers_wednesday_claude_pack/

# credentials (backstop — les vraies clés vivent dans /opt/ai-makers/secrets/)
gsc-service-account.json
service_account_credentials.json
client_secrets.json
